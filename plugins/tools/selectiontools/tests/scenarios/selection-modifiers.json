          "equals": {
            "x": 100,
            "y": 100,
            "width": 200,
            "height": 100
          }
        }
      }
    },
    {
      "call": "action_trigger",
      "args": {
        "name": "edit_undo"
      }
    },
    {
      "call": "wait_idle"
    },
    {
      "call": "query_state",
      "expect": {
        "undo.index": 1,
