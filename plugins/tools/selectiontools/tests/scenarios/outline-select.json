{
  "format": "solstice-test-control-scenario",
  "version": 1,
  "name": "outline-select",
  "description": "A freehand path around a square with the outline selection tool selects exactly that square.",
  "covers": "Freehand (outline) selection tool, spontaneous release ending the shape",
  "steps": [
    {
      "call": "document_new",
      "args": {
        "width": 800,
        "height": 600
      }
    },
    {
      "call": "view_reset"
    },
    {
      "call": "tool_activate",
      "args": {
        "id": "KisToolSelectOutline"
      }
    },
    {
      "call": "input_stroke",
      "args": {
        "points": [
          {
            "x": 100.0,
            "y": 100.0
          },
          {
            "x": 120.0,
            "y": 100.0
          },
