          },
          {
            "x": 300.0,
            "y": 200.0
          },
          {
            "x": 300.0,
            "y": 220.0
          },
          {
            "x": 300.0,
            "y": 240.0
          },
          {
            "x": 300.0,
            "y": 260.0
          },
          {
            "x": 300.0,
            "y": 280.0
          },
          {
            "x": 300.0,
            "y": 300.0
          },
          {
            "x": 280.0,
            "y": 300.0
          },
          {
            "x": 260.0,
            "y": 300.0
          },
          {
