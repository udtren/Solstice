      }
    },
    {
      "call": "wait_idle"
    },
    {
      "call": "query_state",
      "expect": {
        "undo.count": 1,
        "undo.lastCommand": "Freehand Selection",
        "selection.bounds": {
          "equals": {
            "x": 100,
            "y": 100,
            "width": 200,
            "height": 200
          }
        },
        "selection.selectedPixels": 40000
      }
    },
    {
      "call": "document_close"
    }
  ]
