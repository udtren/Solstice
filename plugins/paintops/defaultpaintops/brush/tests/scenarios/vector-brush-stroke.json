{
  "format": "solstice-test-control-scenario",
  "version": 1,
  "name": "vector-brush-stroke",
  "description": "The Freehand Brush draws on a vector layer: each stroke becomes a shape, undo and redo remove and return it, a PNG export leaves the layer unchanged, the eraser cuts the stroke where it crosses it (one undo step), drawing continues afterwards, and the Whole Line eraser removes every line it touches.",
  "covers": "Brush strokes on a vector layer through the input manager (docs/agent/vector-brush-strokes.md)",
  "steps": [
    {
      "call": "document_new",
      "args": {
        "width": 800,
        "height": 600
      }
    },
    {
      "call": "view_reset"
    },
    {
      "call": "action_trigger",
      "args": {
        "name": "add_new_shape_layer"
      }
    },
    {
      "call": "wait_idle"
    },
    {
      "call": "query_state",
      "save": {
        "undoBefore": "undo.count"
      },
      "expect": {
        "activeLayer.class": "KisShapeLayer"
      }
    },
    {
      "call": "tool_activate",
      "args": {
        "id": "KritaShape/KisToolBrush"
      }
    },
    {
      "call": "brush_set",
      "args": {
        "preset": "b) Basic-5 Size Opacity",
        "size": 20,
        "opacity": 1,
        "eraser": false,
        "color": "#000000"
      }
    },
    {
      "call": "query_pixels",
