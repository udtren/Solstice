{
  "format": "solstice-test-control-scenario",
  "version": 1,
  "name": "vector-shape-assistants",
  "covers": "Create Assistants of the Edit Brush Strokes Tool for vector shapes selected with the Select Shapes Tool (docs/agent/vector-brush-strokes.md)",
  "description": "An ellipse drawn with the Ellipse Tool on a vector layer is selected with the Select Shapes Tool. Create Assistants of the Edit Brush Strokes Tool makes one undo step, and a brush stroke drawn 12 px inside the top of the ellipse on a paint layer, with Snap to Assistants on, lies on the ellipse instead of where it was drawn. With nothing selected the button makes no undo step.",
  "steps": [
    {"call": "document_new", "args": {"width": 800, "height": 600}},
    {"call": "view_reset"},
    {"call": "action_trigger", "args": {"name": "add_new_shape_layer"}},
    {"call": "wait_idle"},
    {"call": "tool_activate", "args": {"id": "KritaShape/KisToolEditBrushStrokes"}},
    {"call": "ui_click", "args": {"objectName": "btnEditBrushStrokesCreateAssistants"}},
    {"call": "wait_idle"},
    {"call": "query_state", "expect": {"undo.lastCommand": {"notEquals": "Create Assistants from Brush Strokes"}}},
    {"call": "tool_activate", "args": {"id": "KritaShape/KisToolEllipse"}},
    {"call": "input_stroke", "args": {"points": [{"x": 300, "y": 250}, {"x": 340, "y": 275}, {"x": 380, "y": 300}, {"x": 420, "y": 325}, {"x": 460, "y": 350}]}},
    {"call": "wait_idle"},
    {"call": "tool_activate", "args": {"id": "InteractionTool"}},
    {"call": "input_click", "args": {"x": 380, "y": 251}},
    {"call": "wait_idle"},
    {"call": "tool_activate", "args": {"id": "KritaShape/KisToolEditBrushStrokes"}},
    {"call": "ui_click", "args": {"objectName": "btnEditBrushStrokesCreateAssistants"}},
    {"call": "wait_idle"},
    {"call": "query_state", "expect": {"undo.lastCommand": "Create Assistants from Brush Strokes", "activeLayer.class": "KisShapeLayer"}},
    {"call": "action_trigger", "args": {"name": "add_new_paint_layer"}},
    {"call": "wait_idle"},
    {"call": "query_pixels", "args": {"source": "layer", "x": 377, "y": 247, "width": 7, "height": 7}, "save": {"empty": "sha256"}},
    {"call": "tool_activate", "args": {"id": "KritaShape/KisToolBrush"}},
    {"call": "brush_set", "args": {"preset": "b) Basic-5 Size Opacity", "size": 6, "opacity": 1, "eraser": false, "color": "#ff0000"}},
    {"call": "ui_set", "args": {"objectName": "chkBrushSnapToAssistants", "value": true}},
    {"call": "input_stroke", "args": {"points": [{"x": 360, "y": 262}, {"x": 370, "y": 262}, {"x": 380, "y": 262}, {"x": 390, "y": 262}, {"x": 400, "y": 262}]}},
    {"call": "wait_idle"},
    {"call": "query_pixels", "args": {"source": "layer", "x": 377, "y": 247, "width": 7, "height": 7}, "expect": {"sha256": {"notEquals": "$empty"}}},
    {"call": "query_pixels", "args": {"source": "layer", "x": 377, "y": 259, "width": 7, "height": 7}, "expect": {"sha256": {"equals": "$empty"}}},
    {"call": "ui_set", "args": {"objectName": "chkBrushSnapToAssistants", "value": false}},
    {"call": "brush_set", "args": {"size": 20, "color": "#000000"}},
    {"call": "document_close"}
  ]
}
